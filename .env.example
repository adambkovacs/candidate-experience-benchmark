# Copy to .env and fill only the providers you use. Never commit .env.
# Pass its path using the runner's --env-file option.
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
# Only needed for an authenticated OpenJev endpoint.
OPENJEV_API_KEY=
# Only for a separately approved Cloudflare Clef smoke. The runner can read
# these from process environment or --env-file. Existing CF_ACCOUNT_ID and
# CF_API_TOKEN names are accepted too; do not put values in this example.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
